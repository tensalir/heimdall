# Microsoft Graph (extraction side)
# Create an Azure App Registration in Entra ID with Application permission Sites.Read.All (admin-consented).
# Tenant ID, client ID, and client secret all come from that registration.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Hostname + site path of the SharePoint playbook site.
# Example for https://contoso.sharepoint.com/sites/PlaybookSite :
#   SHAREPOINT_HOSTNAME=contoso.sharepoint.com
#   SHAREPOINT_SITE_PATH=/sites/PlaybookSite
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=

# Anthropic (translator)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Sites (authoring side)
# The full URL of the target Google Site in edit mode (e.g. https://sites.google.com/d/SITE_ID/p/PAGE_ID/edit)
# or the home edit URL (https://sites.google.com/.../home?authuser=0).
GOOGLE_SITES_EDIT_URL=

# Optional: only set if you want to author into a specific named subpage.
GOOGLE_SITES_TARGET_SUBPATH=
