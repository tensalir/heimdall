# Monday
MONDAY_API_TOKEN=
MONDAY_SIGNING_SECRET=
MONDAY_BOARD_ID=
MONDAY_STATUS_FIGMA_READY=
# Optional strict webhook gates (off by default)
# MONDAY_ENFORCE_FILTERS=true
# MONDAY_ALLOWED_STATUS_VALUES=ready for review,brief ready / approved
# MONDAY_ALLOWED_TEAM_VALUES=studio,content creation

# Plugin: filter briefings by status and creative partner (CSV, case-insensitive)
# PLUGIN_FILTER_STATUS=brief ready,approved,ready
# PLUGIN_FILTER_CREATIVE_PARTNER=studio,content creation

# Monday–Frontify asset linking: auto-fill Assets column with Frontify URL when status is Approved
# Independent of Figma: MONDAY_STATUS_FIGMA_READY / MONDAY_ALLOWED_STATUS_VALUES are not used here.
# Get column ID via GET /api/admin/monday/columns?boardId=YOUR_BOARD_ID (admin auth required)
MONDAY_ASSETS_COLUMN_ID=
# CSV of board IDs to enable asset linking on (leave empty for all boards)
# MONDAY_ASSETS_BOARD_IDS=18404406006
# Status that triggers the Assets link only (case-insensitive). Can match Figma status if you want same trigger.
# MONDAY_ASSETS_STATUS_APPROVED=Approved
# Example: if your board uses "Brief ready / approved", set MONDAY_ASSETS_STATUS_APPROVED=Brief ready / approved

# Frontify (asset link URL + optional folder creation)
FRONTIFY_ACCESS_TOKEN=
# FRONTIFY_DOMAIN=loop.frontify.com
# FRONTIFY_LIBRARY_ID=
# FRONTIFY_DOCUMENT_PATH=document/12

# Figma (optional; read-only for V1)
FIGMA_ACCESS_TOKEN=
FIGMA_TEMPLATE_FILE_KEY=

# Figma team IDs for project browser (comma-separated)
# Find your team ID in Figma: https://www.figma.com/files/<org>/team/<TEAM_ID>/...
FIGMA_TEAM_IDS=

# Optional: map canonical month key to Figma file key. Example:
# HEIMDALL_BATCH_FILE_MAP={"2026-03":"abc123xyz"}
# NOTE: In production (Vercel), this is stored in KV and managed via /routing page
HEIMDALL_BATCH_FILE_MAP=

# Dry run (no enqueue, no Monday/Figma writes)
# HEIMDALL_DRY_RUN=true

# Claude mapping agent (optional; omit to use column-only fallback)
ANTHROPIC_API_KEY=
# ANTHROPIC_THINKING_BUDGET=10000

# Babylon localization ingest bridge (Heimdall -> Babylon)
# Signature format:
#   x-localization-timestamp: unix ms
#   x-localization-signature: HMAC_SHA256_HEX(secret, `${timestamp}.${rawBody}`)
LOCALIZATION_BABYLON_INGEST_URL=
LOCALIZATION_BABYLON_SHARED_SECRET=
# LOCALIZATION_BABYLON_KEY_ID=primary

# Vercel KV (auto-set when you link KV store in Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase (comment persistence + auth)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase public keys (needed client-side for auth)
# Find these in Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sheets Authentication (optional; leave empty to disable auth on /sheets and /briefing-assistant)
SHEETS_PASSWORD=

# Briefing Assistant: Meta Ad Library API (required for live ad sync + previews)
#
# Token types (pick one):
#   1. Long-lived User token   (~60 days) — exchange via GET /oauth/access_token
#   2. System User token        (never expires) — generate in Business Manager > System Users
#   3. System User token (60d)  — same as 2 but with set_token_expires_in_60_days=true
#
# Rotation:
#   - For 60-day tokens, refresh before expiry via the /oauth/access_token exchange endpoint.
#   - After rotation, call POST /api/briefing-assistant/meta-ads?action=warm-thumbnails
#     to re-extract media for any ads whose CDN URLs may have expired.
#
# META_AD_LIBRARY_ACCESS_TOKEN=

# Apify API token for Meta ads scraping (recommended; handles proxies/tokens automatically)
# Get your token at https://console.apify.com/account/integrations
# Pricing: ~$0.75 per 1,000 ads via curious_coder/facebook-ads-library-scraper
# APIFY_API_TOKEN=

# SearchAPI key for scalable Meta Ad Library scraping (structured JSON with media URLs)
# Get your key at https://www.searchapi.io — credit-based pricing
# SEARCHAPI_API_KEY=

# Meta Ads source mode: 'searchapi' | 'apify' | 'browser' | 'api' | 'auto' (default)
# auto = apify first (if token set), then browser, then API fallback
# searchapi = SearchAPI only (requires SEARCHAPI_API_KEY)
# META_ADS_SOURCE_MODE=auto

# Default region for Meta ads scraping (ISO country code)
# META_ADS_DEFAULT_REGION=US

# HTTP/SOCKS proxy for browser scraping (useful for EU-based servers)
# META_ADS_PROXY_URL=

# Briefing Assistant: Vesper image generation gateway (optional; fallback to GEMINI_API_KEY)
# VESPER_API_URL=https://vesper.yourinstance.com
# VESPER_API_SECRET=

# Briefing Assistant: Direct Gemini API for Nano Banana (optional fallback)
# GEMINI_API_KEY=

# Briefing Assistant: Exa web search (trend discovery + social listening)
# EXA_API_KEY=

# Briefing Assistant: Perplexity digest synthesis (trend + social listening digests)
# PERPLEXITY_API_KEY=

# Briefing Assistant: Voyage embeddings for evidence RAG
# VOYAGE_API_KEY=

# Briefing Assistant: Monday briefing board and doc columns
# MONDAY_BRIEFING_BOARD_ID=
# MONDAY_BRIEFING_DOC_COLUMN_ID=
# MONDAY_BRIEFING_GROUP_ID=

# HiBob → Monday leave sync
# Service user credentials from HiBob Settings > Integrations > Service Users
HIBOB_SERVICE_USER_ID=
HIBOB_API_TOKEN=
# Shared secret for verifying HiBob webhook calls (appended as ?secret=VALUE to the webhook URL)
# Generate with: openssl rand -hex 32
# HIBOB_WEBHOOK_SECRET=
# Monday board for the team roster (board ID from the URL: loopearplugs.monday.com/boards/<ID>)
MONDAY_HIBOB_BOARD_ID=4826368978
# Column IDs — find these via GET /api/admin/monday/columns?boardId=4826368978 (admin auth required)
MONDAY_HIBOB_EMAIL_COLUMN_ID=
MONDAY_HIBOB_STATUS_COLUMN_ID=
# Optional: extra columns for richer leave data
# MONDAY_HIBOB_LEAVE_TYPE_COLUMN_ID=
# MONDAY_HIBOB_LEAVE_START_COLUMN_ID=
# MONDAY_HIBOB_LEAVE_END_COLUMN_ID=

# Shared secret for machine-to-machine API auth (plugin, jobs, cron routes).
# Generate with: openssl rand -hex 32
# When set, /api/jobs/*, /api/plugin/*, and cron endpoints require
# X-Heimdall-Secret header matching this value. Used for cron/jobs.
# HEIMDALL_MACHINE_SECRET=

# Separate plugin auth token for Figma plugin. Revocable independently.
# Plugin users enter this once; it's sent as X-Heimdall-Plugin-Token.
# HEIMDALL_PLUGIN_SECRET=

# Custom GPT Actions: secret for POST /api/gpt-actions/search and /answer (header or Bearer).
# Generate with: openssl rand -hex 32
# HEIMDALL_GPT_ACTIONS_SECRET=

# LlamaCloud / LlamaParse (Loop Document Chat — PDF/DOCX/PPTX/XLSX). Get key from cloud.llamaindex.ai
# LLAMA_CLOUD_API_KEY=
# Optional: fast | cost_effective | agentic | agentic_plus (default cost_effective)
# LLAMA_PARSE_TIER=cost_effective
# Optional: pin tier config version (default latest). Example: 2026-03-04
# LLAMA_PARSE_VERSION=latest

# CSV of email domains allowed for privileged access (admin/ops/forecast/feedback).
# Defaults to thoughtform.co,loopearplugs.com if not set.
# HEIMDALL_ALLOWED_EMAIL_DOMAINS=thoughtform.co,loopearplugs.com

# Vercel Deployment Protection bypass secret (created in Vercel project settings).
# Used by the Figma plugin build to pre-fill the bypass query param.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Mimir (briefing assistant) — when set, nav links point to external Mimir app
# NEXT_PUBLIC_MIMIR_URL=https://mimir-your-team.vercel.app/briefing-assistant

PORT=3846
